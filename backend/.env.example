# Application
APP_NAME=DevInsight AI
DEBUG=False

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devinsight

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Providers
# IBM watsonx.ai
WATSONX_API_KEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# OpenAI (Fallback)
OPENAI_API_KEY=your-openai-api-key-here

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Cache
CACHE_TTL_SECONDS=1800

# Logging
LOG_LEVEL=INFO